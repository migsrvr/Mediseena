# ==============================================================================
# MEDISEENA ENVIRONMENT CONFIGURATION
# Section 3.6: Architecture, Supabase Services, and Gemini Vision
# ==============================================================================

# Supabase Project Configuration (PostgreSQL, Auth, Storage)
# VITE_* values are bundled into the public JavaScript; only publishable keys belong here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini Vision API Key: do NOT add it here.
# It is a Supabase Edge Function secret:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
